# 复制为 providers.env 并按需填写;不用的留空,对应 provider 自动跳过
# 安全纪律:agent 只核对 key 名,不读取值

# 智谱 GLM(open.bigmodel.cn)
ZHIPUAI_API_KEY=
ZHIPUAI_MODEL=glm-5,glm-5-turbo,glm-4.6

# Google Gemini(OpenAI 兼容口)
GEMINI_API_KEY=
GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.1-pro-preview,gemini-3.7-flash,gemini-2.5-pro

# Claude 中转站(Claude Code CLI 无头通道;BASE 不要带 /v1)
CLAUDE_RELAY_KEY=
CLAUDE_RELAY_BASE=
CLAUDE_RELAY_MODEL=claude-opus-4-5

# Codex(OpenAI 位,本地 CLI,无 key;路径非默认时填)
CODEX_BIN=
CLAUDE_BIN=

# 缺省目标目录(不传目标文件时找 LESSONS.jsonl/rules/operator-rules-v1.md/GROWTH.md)
ARTIFACT_DIR=.
